@page "/overlays"
@using Web.Components.Services
@inject OverlayApiClient OverlayApiClient
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Overlays</PageTitle>

<div class="overlays-page">
    <h1 class="overlays-title">Overlays</h1>
    <p class="overlays-subtitle">
        Browser sources for your OBS scenes. Grab an overlay's URL, add a Browser source in OBS, and paste it in —
        that's the whole ritual.
    </p>

    @if (loading)
    {
        <ul class="overlay-list" aria-hidden="true">
            <li class="overlay-card overlay-card--skeleton"></li>
            <li class="overlay-card overlay-card--skeleton"></li>
        </ul>
    }
    else if (overlays is null)
    {
        <p class="overlays-note overlays-note--down">
            <span class="overlays-note-icon" aria-hidden="true">🔌</span>
            Can't reach the overlay service right now. It might still be waking up — try again in a moment.
        </p>
    }
    else if (overlays.Length == 0)
    {
        <p class="overlays-note">
            <span class="overlays-note-icon" aria-hidden="true">🎬</span>
            No overlays wired up yet. As each one gets built it'll show up here, ready to drop straight into OBS.
        </p>
    }
    else
    {
        <ul class="overlay-list">
            @foreach (var overlay in overlays)
            {
                var url = BuildUrl(overlay);
                var copied = copiedSlug == overlay.Slug;
                var expanded = expandedSlugs.Contains(overlay.Slug);
                var primarySettings = overlay.Settings.Where(s => s.IsPrimary).ToArray();
                var secondarySettings = overlay.Settings.Where(s => !s.IsPrimary).ToArray();

                <li class="overlay-card" @key="overlay.Slug">
                    <div class="overlay-head">
                        <span class="overlay-name">@overlay.DisplayName</span>
                        <div class="overlay-meta">
                            <span class="overlay-dims mono" title="Recommended OBS browser-source size">@overlay.DefaultWidth×@overlay.DefaultHeight</span>
                            @if (overlay.RequiresBotAuth)
                            {
                                <span class="overlay-badge overlay-badge--bot" title="Needs the Bot account's Twitch auth">🤖 Bot</span>
                            }
                            @if (overlay.RequiresBroadcasterAuth)
                            {
                                <span class="overlay-badge overlay-badge--broadcaster" title="Needs the Broadcaster account's Twitch auth">📺 Broadcaster</span>
                            }
                            @if (!overlay.RequiresBotAuth && !overlay.RequiresBroadcasterAuth)
                            {
                                <span class="overlay-badge overlay-badge--none">No auth needed</span>
                            }
                        </div>
                    </div>
                    <p class="overlay-desc">@overlay.Description</p>

                    @if (primarySettings.Length > 0 || overlay.Slug == "starting")
                    {
                        <div class="overlay-settings">
                            @foreach (var setting in primarySettings)
                            {
                                @RenderSetting(overlay, setting)
                            }
                            @if (overlay.Slug == "starting")
                            {
                                @RenderStartingCountdown()
                            }
                        </div>
                    }

                    @if (secondarySettings.Length > 0)
                    {
                        <button type="button"
                                class="overlay-customize-toggle"
                                aria-expanded="@(expanded ? "true" : "false")"
                                aria-controls="@($"overlay-customize-{overlay.Slug}")"
                                @onclick="() => ToggleExpanded(overlay.Slug)">
                            <span class="overlay-customize-chevron @(expanded ? "overlay-customize-chevron--open" : "")" aria-hidden="true">▸</span>
                            @(expanded ? "Hide customization" : "Customize")
                        </button>
                        <div id="@($"overlay-customize-{overlay.Slug}")" class="overlay-customize-panel @(expanded ? "overlay-customize-panel--open" : "")">
                            <div class="overlay-settings overlay-settings--secondary">
                                @foreach (var setting in secondarySettings)
                                {
                                    @RenderSetting(overlay, setting)
                                }
                            </div>
                        </div>
                    }

                    <div class="overlay-url-row">
                        <code class="overlay-url mono">@url</code>
                        <button type="button"
                                class="overlay-copy @(copied ? "overlay-copy--done" : "")"
                                @onclick="() => CopyUrl(overlay.Slug, url)">
                            <span class="overlay-copy-icon" aria-hidden="true">@(copied ? "✓" : "⧉")</span>
                            @(copied ? "Copied" : "Copy URL")
                        </button>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private OverlayModuleItem[]? overlays;
    private bool loading = true;
    private string? copiedSlug;
    private readonly Dictionary<string, Dictionary<string, string>> currentValues = new();
    private readonly HashSet<string> expandedSlugs = new();
    private DateTimeOffset? startingCountdown;
    private bool startingCountdownSaveFailed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            overlays = await OverlayApiClient.GetOverlays();
            if (overlays is not null)
            {
                foreach (var overlay in overlays)
                {
                    currentValues[overlay.Slug] = overlay.Settings.ToDictionary(s => s.Key, s => s.DefaultValue);
                }

                if (overlays.Any(o => o.Slug == "starting"))
                {
                    startingCountdown = await OverlayApiClient.GetStartingCountdown();
                }
            }
            loading = false;
            StateHasChanged();
        }
    }

    // Only settings that differ from their default ride on the copied URL, so an
    // untouched overlay still copies a clean base URL (see the design brief).
    private string BuildUrl(OverlayModuleItem overlay)
    {
        var values = currentValues[overlay.Slug];
        var changed = overlay.Settings
            .Where(s => values[s.Key] != s.DefaultValue)
            .ToDictionary(s => s.Key, s => values[s.Key]);

        return OverlayApiClient.BuildBrowserSourceUrl(overlay.Slug, changed);
    }

    private void ToggleExpanded(string slug)
    {
        if (!expandedSlugs.Remove(slug))
        {
            expandedSlugs.Add(slug);
        }
    }

    private RenderFragment RenderSetting(OverlayModuleItem overlay, OverlaySettingItem setting) => @<label class="overlay-setting-field">
        <span>@setting.Label</span>
        @switch (setting.Type)
        {
            case OverlaySettingType.Select:
                <select class="overlay-setting-input"
                        value="@currentValues[overlay.Slug][setting.Key]"
                        @onchange="e => SetValue(overlay.Slug, setting.Key, e.Value)">
                    @foreach (var option in setting.Options ?? [])
                    {
                        <option value="@option">@option</option>
                    }
                </select>
                break;
            case OverlaySettingType.Number:
                <input class="overlay-setting-input" type="number"
                       value="@currentValues[overlay.Slug][setting.Key]"
                       @oninput="e => SetValue(overlay.Slug, setting.Key, e.Value)" />
                break;
            default:
                <input class="overlay-setting-input" type="text"
                       value="@currentValues[overlay.Slug][setting.Key]"
                       @oninput="e => SetValue(overlay.Slug, setting.Key, e.Value)" />
                break;
        }
        @if (!string.IsNullOrEmpty(setting.HelperText) && string.IsNullOrWhiteSpace(currentValues[overlay.Slug][setting.Key]))
        {
            <span class="overlay-setting-helper">⏳ @setting.HelperText</span>
        }
    </label>;

    private void SetValue(string slug, string key, object? value)
    {
        currentValues[slug][key] = value?.ToString() ?? string.Empty;
    }

    // The starting overlay's countdown target is set here and persisted server-side
    // (see OverlayApiClient.SetStartingCountdown) rather than baked into the copied
    // URL - so the URL pasted into OBS never needs to change from stream to stream.
    // Small streamers rarely run to a fixed schedule - "starts in 15 minutes" is the
    // realistic entry point, not a calendar pick - so the picker stays as a fallback.
    private static readonly int[] QuickSetMinutes = [5, 10, 15, 30, 60];

    private static string FormatQuickSetLabel(int minutes) =>
        minutes % 60 == 0 ? $"{minutes / 60}h" : $"{minutes}m";

    private RenderFragment RenderStartingCountdown() => @<label class="overlay-setting-field">
        <span>Starts at</span>
        <div class="overlay-quickset">
            @foreach (var minutes in QuickSetMinutes)
            {
                <button type="button" class="overlay-quickset-btn" @onclick="() => SetStartingCountdown(minutes)">in @FormatQuickSetLabel(minutes)</button>
            }
            @if (startingCountdown is not null)
            {
                <button type="button" class="overlay-quickset-btn" @onclick="ClearStartingCountdown">clear</button>
            }
        </div>
        <input class="overlay-setting-input" type="datetime-local"
               value="@(startingCountdown?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
               @onchange="OnStartingCountdownPicked" />
        @if (startingCountdownSaveFailed)
        {
            <span class="overlay-setting-helper">⚠️ Couldn't save - check the overlay service and try again</span>
        }
        else if (startingCountdown is null)
        {
            <span class="overlay-setting-helper">⏳ Not set - shows a static message instead of a countdown</span>
        }
        else
        {
            <span class="overlay-setting-helper">🔴 Live on the overlay now - the OBS URL never has to change</span>
        }
    </label>;

    private Task SetStartingCountdown(int minutesFromNow) =>
        ApplyStartingCountdown(DateTimeOffset.Now.AddMinutes(minutesFromNow));

    private Task ClearStartingCountdown() => ApplyStartingCountdown(null);

    private async Task OnStartingCountdownPicked(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var local))
        {
            await ApplyStartingCountdown(new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Local)));
        }
    }

    private async Task ApplyStartingCountdown(DateTimeOffset? target)
    {
        var success = await OverlayApiClient.SetStartingCountdown(target);
        startingCountdownSaveFailed = !success;
        if (success)
        {
            startingCountdown = target;
        }
        StateHasChanged();
    }

    private async Task CopyUrl(string slug, string url)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        copiedSlug = slug;
        StateHasChanged();

        await Task.Delay(1500);
        if (copiedSlug == slug)
        {
            copiedSlug = null;
            StateHasChanged();
        }
    }
}
